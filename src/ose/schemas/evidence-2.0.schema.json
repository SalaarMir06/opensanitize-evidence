{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensanitize.org/schemas/evidence-2.0.schema.json",
  "title": "OpenSanitize Evidence Schema 2.0",
  "description": "Common evidence collection manifest for OSE.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection",
    "target",
    "identity",
    "commands",
    "artifacts",
    "capture",
    "assessment",
    "safety",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_id",
        "collector",
        "adapter",
        "started_utc",
        "finished_utc",
        "status"
      ],
      "properties": {
        "collection_id": {
          "type": "string",
          "minLength": 1
        },
        "collector": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "started_utc": {
          "type": "string",
          "format": "date-time"
        },
        "finished_utc": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ]
        },
        "error": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_identity",
        "observations"
      ],
      "properties": {
        "expected_identity": {
          "type": "object",
          "required": [
            "serial"
          ],
          "properties": {
            "serial": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "observations": {
          "type": "object",
          "required": [
            "before",
            "after"
          ],
          "properties": {
            "before": {
              "type": [
                "object",
                "null"
              ]
            },
            "after": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "FAILED",
            "NOT_CHECKED"
          ]
        },
        "checks": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "name",
          "argv",
          "started_utc",
          "finished_utc",
          "duration_seconds",
          "exit_code",
          "timed_out",
          "execution_status",
          "artifact_ids",
          "extensions"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "timed_out": {
                  "const": true
                }
              },
              "required": [
                "timed_out"
              ]
            },
            "then": {
              "properties": {
                "exit_code": {
                  "type": "null"
                },
                "execution_status": {
                  "const": "TIMED_OUT"
                }
              }
            },
            "else": {
              "properties": {
                "exit_code": {
                  "type": "integer"
                },
                "execution_status": {
                  "const": "COMPLETED"
                }
              }
            }
          }
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "started_utc": {
            "type": "string",
            "format": "date-time"
          },
          "finished_utc": {
            "type": "string",
            "format": "date-time"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "timed_out": {
            "type": "boolean"
          },
          "execution_status": {
            "enum": [
              "COMPLETED",
              "TIMED_OUT"
            ]
          },
          "artifact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "extensions": {
            "type": "object"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "role",
          "path",
          "media_type",
          "size_bytes",
          "hash"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\s*$)(?!/)(?![A-Za-z]:)(?!.*[\\u0000-\\u001F\\u007F])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*/$).+$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "hash": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "value"
            ],
            "properties": {
              "algorithm": {
                "const": "sha256"
              },
              "value": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "INCOMPLETE"
          ]
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_ASSESSED",
            "UNDER_REVIEW",
            "CONFORMANT",
            "NON_CONFORMANT",
            "INCONCLUSIVE"
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only_collection",
        "destructive_commands_executed"
      ],
      "properties": {
        "read_only_collection": {
          "type": "boolean"
        },
        "destructive_commands_executed": {
          "type": "boolean"
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
